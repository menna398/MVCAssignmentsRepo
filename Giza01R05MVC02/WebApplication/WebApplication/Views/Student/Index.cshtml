@model List<Student>

<h2>All Students</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Department id</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Name</td>
				<td>@item.Age</td>
                <td>@item.DepartmentId</td>
            </tr>
        }
    </tbody>
</table>