@model List<Course>

<h2>All Courses</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Degree</th>
            <th>Department id</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Degree</td>
				<td>@item.DepartmentId</td>
            </tr>
        }
    </tbody>
</table>